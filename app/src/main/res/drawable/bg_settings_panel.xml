<?xml version="1.0" encoding="utf-8"?>
<!-- Panel frame: bronze rim, gold rim, night-sky fill, thin cyan inner line. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sf_bronze" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/sf_gold" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/sf_panel_top"
                android:endColor="@color/sf_panel_bottom" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="11dp" android:top="11dp" android:right="11dp" android:bottom="11dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/sf_cyan_line" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
