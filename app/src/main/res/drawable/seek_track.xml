<?xml version="1.0" encoding="utf-8"?>
<!-- Slider bar: dark groove with a cyan-to-violet fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/sf_track" />
            <stroke android:width="1dp" android:color="@color/sf_track_edge" />
            <corners android:radius="5dp" />
            <size android:height="10dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/sf_cyan"
                    android:endColor="@color/sf_violet" />
                <corners android:radius="5dp" />
                <size android:height="10dp" />
            </shape>
        </clip>
    </item>
</layer-list>
