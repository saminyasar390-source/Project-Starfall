<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen. Each view with an android:id becomes a field in ActivitySettingsBinding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050818">

    <!-- The menu artwork, dimmed, so the settings feel like part of the same world. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/menu_main" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sf_dim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_settings_fade" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- The framed panel (about 60% of the screen width). -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_panel"
                    android:orientation="vertical"
                    android:paddingStart="30dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="30dp"
                    android:paddingBottom="22dp">

                    <!-- Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ornament" />

                        <TextView
                            android:id="@+id/tvTitle"
                            style="@style/SfLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:letterSpacing="0.18"
                            android:shadowColor="#997FE3FF"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="14"
                            android:text="@string/settings_title"
                            android:textSize="28sp" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ornament" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/divider_gold" />

                    <!-- Music volume -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnMusicDown"
                            style="@style/SfRoundButton"
                            android:contentDescription="@string/cd_music_down"
                            android:text="−" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMusicLabel"
                                style="@style/SfLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/settings_music" />

                            <SeekBar
                                android:id="@+id/seekMusic"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:maxHeight="10dp"
                                android:minHeight="10dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:progressDrawable="@drawable/seek_track"
                                android:splitTrack="false"
                                android:thumb="@drawable/seek_thumb" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnMusicUp"
                            style="@style/SfRoundButton"
                            android:contentDescription="@string/cd_music_up"
                            android:text="+" />
                    </LinearLayout>

                    <!-- Sound effects volume -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSfxDown"
                            style="@style/SfRoundButton"
                            android:contentDescription="@string/cd_sfx_down"
                            android:text="−" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSfxLabel"
                                style="@style/SfLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/settings_sfx" />

                            <SeekBar
                                android:id="@+id/seekSfx"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:maxHeight="10dp"
                                android:minHeight="10dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:progressDrawable="@drawable/seek_track"
                                android:splitTrack="false"
                                android:thumb="@drawable/seek_thumb" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnSfxUp"
                            style="@style/SfRoundButton"
                            android:contentDescription="@string/cd_sfx_up"
                            android:text="+" />
                    </LinearLayout>

                    <!-- Graphics quality -->
                    <TextView
                        style="@style/SfLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/settings_graphics" />

                    <RadioGroup
                        android:id="@+id/rgQuality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbLow"
                            style="@style/SfRadio"
                            android:text="@string/quality_low" />

                        <RadioButton
                            android:id="@+id/rbMedium"
                            style="@style/SfRadio"
                            android:text="@string/quality_medium" />

                        <RadioButton
                            android:id="@+id/rbHigh"
                            style="@style/SfRadio"
                            android:text="@string/quality_high" />
                    </RadioGroup>

                    <!-- Footer: extras on the left, OK / BACK on the right -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnGithub"
                            style="@style/SfButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_github"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnShare"
                            style="@style/SfButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_share"
                            android:textSize="12sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnOk"
                            style="@style/SfButton"
                            android:layout_width="104dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_primary"
                            android:text="@string/btn_ok" />

                        <TextView
                            android:id="@+id/btnBack"
                            style="@style/SfButton"
                            android:layout_width="104dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:text="@string/btn_back" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Gold star ornaments on the four corners of the frame -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="-3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ornament" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="-3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ornament" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="-3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ornament" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="-3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ornament" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
